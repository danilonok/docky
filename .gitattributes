# Docky is a Python backend; the React frontend is a bundled client.
# Excluding it from Linguist keeps the repo's reported language accurate.
frontend/** linguist-vendored

# Generated artifacts - not hand-written source.
uv.lock                        linguist-generated
frontend/openapi.json          linguist-generated
frontend/app/package-lock.json linguist-generated

# Shell scripts run inside Linux containers. A Windows checkout with
# core.autocrlf=true would otherwise hand Docker a script with CRLF endings,
# whose shebang the container cannot execute.
*.sh text eol=lf
