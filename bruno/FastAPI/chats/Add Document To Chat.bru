meta {
  name: Add Document To Chat
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/chats/documents
  body: none
  auth: inherit
}

params:query {
  documentId: 
  chatId: 
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/chats/documents
    method: POST
    mode: none
    params:query: {
      documentId: 
      chatId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "",
          "title": "",
          "created_at": ""
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/chats/documents
    method: POST
    mode: none
